[Unit]
Description=PFAI 24/7 Continuous Training Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pfai
Group=pfai
WorkingDirectory=/opt/pfai
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/pfai/run_continuous.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/pfai/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
