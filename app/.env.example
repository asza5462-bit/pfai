# Never commit real values. Copy to a private secret store / platform env.
# This file is a TEMPLATE ONLY — empty placeholders, no credentials.

# ---------------------------------------------------------------------------
# Owner identity (required for owner routes / passcode login)
# ---------------------------------------------------------------------------
# Canonical:
PFAI_OWNER_EMAIL=
# Alias accepted by docs/operator convention (set the same value as above):
# OWNER_EMAIL=

# Passcode HASH only (never plaintext). Generate with: python -m pfai.hash_owner_secret
PFAI_OWNER_SECRET_HASH=

# Email OTP delivery was permanently removed. Owner auth is passcode + session only.
# Do not set PFAI_EMAIL_* / PFAI_SMTP_* / PFAI_OTP_* for login.

# ---------------------------------------------------------------------------
# Web Fabric (optional outbound research)
# Statuses: NOT_CONFIGURED | TEST_ONLY (mock) | READY (network + provider)
# No commercial vendor is mandatory.
# ---------------------------------------------------------------------------
# PFAI_WEB_ALLOW_NETWORK=1
# PFAI_WEB_SEARCH_PROVIDER=auto
# PFAI_WEB_FETCH_PROVIDER=http_fetch
# PFAI_WEB_SEARCH_ENDPOINT=
# PFAI_WEB_SEARCH_API_KEY=   # SECRET if used — never commit
# PFAI_WEB_TIMEOUT=15
# PFAI_WEB_ALLOW_PRIVATE=0

# ---------------------------------------------------------------------------
# MCP (external tools) — untrusted by default; owner must approve trust
# Status: READY (adapter present) | servers remain untrusted until approved
# ---------------------------------------------------------------------------
# PFAI_MCP_SERVERS_PATH=data/longevity/elite/mcp_servers.json
# No server credentials belong in this file.

# ---------------------------------------------------------------------------
# Other (unchanged)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=       # optional remote model; never required for core
# PFAI_COOKIE_SECURE=true  # production HTTPS
PFAI_HOST=0.0.0.0
PORT=8000
PFAI_LOG_LEVEL=INFO
