# Never commit real values. Copy to a private secret store / platform env.
# This file is a TEMPLATE ONLY — empty placeholders, no credentials.

# ---------------------------------------------------------------------------
# Owner identity (required for owner routes / email+password login)
# ---------------------------------------------------------------------------
PFAI_OWNER_EMAIL=
# Password HASH only (never plaintext). Generate with: python -m pfai.hash_owner_secret
PFAI_OWNER_SECRET_HASH=

# Email OTP delivery was permanently removed. Owner auth is email + password only.
# Do not set PFAI_EMAIL_* / PFAI_SMTP_* / PFAI_OTP_* for authentication.

# ---------------------------------------------------------------------------
# Web Fabric (optional outbound research)
# ---------------------------------------------------------------------------
# PFAI_WEB_ALLOW_NETWORK=1
# PFAI_WEB_SEARCH_PROVIDER=auto
# PFAI_WEB_FETCH_PROVIDER=http_fetch

# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# PFAI_COOKIE_SECURE=true
PFAI_HOST=0.0.0.0
PORT=8000
PFAI_LOG_LEVEL=INFO
