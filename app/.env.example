# Never commit real values. Copy to .env locally if needed (gitignored).
# On Render/Railway/VM, set these as platform secrets/environment variables.

# Anthropic Claude (required for real model answers / teacher scoring)
ANTHROPIC_API_KEY=

# Owner identity + passcode HASH only (never plaintext)
# Production identity for this operator:
PFAI_OWNER_EMAIL=szz5462@gmail.com
# Generate a NEW hash (treat any shared/dev passcode as compromised before deploy):
#   python -m pfai.hash_owner_secret
# Or legacy: python3 -c 'import hashlib; print(hashlib.sha256(b"YOUR_NEW_SECRET").hexdigest())'
PFAI_OWNER_SECRET_HASH=

# Production hosts MUST set this and serve only over HTTPS.
# PFAI_ENV=production forces Secure session cookies (cannot be disabled).
# PFAI_ENV=production
# PFAI_COOKIE_SECURE=true
# Local HTTP development (non-production only):
# PFAI_COOKIE_SECURE=false

# Optional: force continuous training on/off (overrides configs/default.json)
# PFAI_CONTINUOUS_TRAINING_ENABLED=true
# PFAI_CONTINUOUS_TRAINING_ENABLED=false

# Optional: separate frontend origins (comma-separated)
# PFAI_CORS_ORIGINS=https://app.example.com

# Bind settings (used by run_web.py / containers)
PFAI_HOST=0.0.0.0
PORT=8000
PFAI_LOG_LEVEL=INFO

# Optional local student model for REAL SFT/LoRA (Claude remains teacher/evaluator)
# PFAI_LOCAL_MODEL_ID=
